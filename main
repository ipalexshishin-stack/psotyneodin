<script>
// Инициализация Telegram Web App
const tg = window.Telegram.WebApp;
tg.expand();
tg.ready();
// Установка цвета хедера в зависимости от темы ТГ (опционально, оставляем красный для важности)
tg.setHeaderColor('#dc2626');
function switchTab(tabId) {
// Скрыть все вкладки
document.querySelectorAll('.tab-content').forEach(tab => {
tab.classList.remove('active');
});
// Сбросить стили всех кнопок навигации
document.querySelectorAll('.nav-btn').forEach(btn => {
btn.classList.remove('text-blue-600', 'text-red-600');
btn.classList.add('text-gray-400');
});
// Показать выбранную вкладку
document.getElementById('tab-' + tabId).classList.add('active');
// Выделить активную кнопку
const activeBtn = document.getElementById('nav-' + tabId);
activeBtn.classList.remove('text-gray-400');
if(tabId === 'sos') {
activeBtn.classList.add('text-red-600');
} else {
activeBtn.classList.add('text-blue-600');
}
// Легкая вибрация при переключении
if(tg.HapticFeedback) {
tg.HapticFeedback.selectionChanged();
}
}
function toggleAccordion(id) {
const content = document.getElementById(id);
const icon = document.getElementById('icon-' + id);
if (content.style.maxHeight) {
content.style.maxHeight = null;
icon.classList.remove('rotate-180');
} else {
// Закрываем другие (опционально, здесь сделаем независимые)
content.style.maxHeight = content.scrollHeight + "px";
icon.classList.add('rotate-180');
}
}
</script>
