    <script>
        function openTab(tabId, tabName) {
            // Скрываем все вкладки
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Сбрасываем стили всех кнопок в меню
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('active');
            });

            // Показываем нужную вкладку
            document.getElementById(tabId).classList.add('active');
            
            // Активируем нужную кнопку (если это не главная страница, так как её нет в нижнем меню)
            const activeBtn = document.getElementById('nav-' + tabId);
            if (activeBtn) {
                activeBtn.classList.add('active');
            }

            // Обновляем хлебные крошки
            document.getElementById('breadcrumb-current').textContent = tabName;
            
            // Прокрутка наверх плавно
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleAccordion(accId) {
            const content = document.getElementById(accId);
            const icon = content.previousElementSibling.querySelector('.fa-chevron-down');
            
            if (content.classList.contains('open')) {
                content.classList.remove('open');
                icon.style.transform = 'rotate(0deg)';
            } else {
                content.classList.add('open');
                icon.style.transform = 'rotate(180deg)';
                icon.style.transition = 'transform 0.3s ease';
            }
        }

        function shareApp() {
            const btn = document.getElementById('share-btn');
            const originalText = btn.innerHTML;
            
            if (navigator.share) {
                navigator.share({
                    title: 'ПСО "Ты не один"',
                    text: 'Мини-приложение поисково-спасательного отряда "Ты не один". Экстренный алгоритм действий, актуальные ориентировки и памятки по безопасности.',
                    url: window.location.href
                }).catch((error) => console.log('Ошибка шаринга:', error));
            } else {
                const dummy = document.createElement('input');
                document.body.appendChild(dummy);
                dummy.value = window.location.href;
                dummy.select();
                document.execCommand('copy');
                document.body.removeChild(dummy);
                
                btn.innerHTML = '<i class="fa-solid fa-check mr-2 text-xl"></i> Ссылка скопирована!';
                btn.classList.replace('text-squad', 'text-green-600');
                btn.classList.replace('border-gray-200', 'border-green-300');
                
                setTimeout(() => { 
                    btn.innerHTML = originalText; 
                    btn.classList.replace('text-green-600', 'text-squad');
                    btn.classList.replace('border-green-300', 'border-gray-200');
                }, 2000);
            }
        }

        // Фикс для ссылок внутри ВКонтакте (VK Mini Apps)
        // ВКонтакте блокирует обычные внешние ссылки в iframe, направляем их через мост
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', (e) => {
                    const href = link.getAttribute('href');
                    if (href && href.startsWith('http')) {
                        e.preventDefault();
                        if (typeof vkBridge !== 'undefined' && vkBridge.send) {
                            vkBridge.send('VKWebAppOpenUrl', { url: href }).catch(() => {
                                window.open(href, '_blank') || (window.location.href = href);
                            });
                        } else {
                            window.open(href, '_blank') || (window.location.href = href);
                        }
                    }
                });
            });
        });
    </script>
